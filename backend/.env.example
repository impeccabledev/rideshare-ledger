# Supabase (required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_secret_key_from_supabase

# Twilio SMS Configuration (optional - for sending notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# App URL for SMS messages
APP_URL=https://your-frontend-url.com

# Server Port
PORT=4000

# Login credentials (recommended): JSON or comma/newline-separated group=join-code pairs
# Examples:
# GROUP_CREDENTIALS={"northstar-team":"12345678","eastside":"ABCD1234"}
# GROUP_CREDENTIALS=northstar-team=12345678,eastside=ABCD1234
# Legacy alias: GROUP_JOIN_CODES

